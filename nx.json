{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{workspaceRoot}/**/dist/**",
      "!{workspaceRoot}/**/.tanstack/**",
      "!{workspaceRoot}/**/routeTree.gen.ts",
      "!{workspaceRoot}/**/.expo/**",
      "!{workspaceRoot}/**/ios/**",
      "!{workspaceRoot}/**/android/**",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "check": {
      "cache": true,
      "dependsOn": [
        "^check"
      ],
      "inputs": [
        "default",
        "^default"
      ]
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ]
    },
    "dev": {
      "cache": false,
      "continuous": true
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "continuous": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "continuous": true
    },
    "env:generate": {
      "cache": true
    }
  },
  "analytics": false,
  "nxCloudId": "6ae7df543cf5c336a0caefd5"
}
