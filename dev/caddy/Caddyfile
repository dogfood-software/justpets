{
	local_certs
}

justpets.localhost {
	# TODO: validate this does not break streaming from NextJS
	encode zstd gzip

	handle /api/* {
		reverse_proxy host.docker.internal:4041
	}

	handle /app* {
		reverse_proxy host.docker.internal:4042
	}

	handle {
		reverse_proxy host.docker.internal:4040 {
			# Disable buffering for streaming
			flush_interval -1
		}

		header {
			X-Accel-Buffering "no"
		}
	}
}

