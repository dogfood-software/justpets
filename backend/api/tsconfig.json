{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "outDir": "dist",
    "paths": {
      "@backend/api/*": ["./src/*"],
    }
  },
  "include": ["src/**/*", "package.json"],
  "exclude": ["src/**/*.test.ts", "vitest.config.ts", "dist"]
}
