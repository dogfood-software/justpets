{
  "name": "justpets",
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "author": "Dogfood Software LLC",
  "scripts": {
    "check": "pnpm lint && pnpm format:check && pnpm nx run-many -t check",
    "test": "pnpm nx run-many -t test",
    "format": "prettier --write .",
    "dev": "pnpm nx run-many -t dev",
    "db:migrate": "pnpm --filter @backend/db db:migrate",
    "services:up": "docker compose -f ./dev/compose.yml up -d",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@tanstack/eslint-config": "0.5.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "nx": "^24.0.6",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.23.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
