{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "@web/site",
      "type": "node",
      "request": "launch",
      "runtimeVersion": "26.13.1",
      "program": "${workspaceFolder}/web/site/node_modules/next/dist/bin/next",
      "runtimeArgs": ["--inspect"],
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}/web/site"
      },
      "cwd": "${workspaceFolder}/web/site"
    },
    {
      "name": "@backend/api",
      "type": "bun",
      "request": "launch",
      "runtime": "${env:HOME}/.bun/bin/bun",
      "program": "${workspaceFolder}/backend/api/src/server.ts",
      "cwd": "${workspaceFolder}/backend/api",
      "watchMode": true,
      "env": {
        "NODE_ENV": "development"
      }
    }
  ]
}
