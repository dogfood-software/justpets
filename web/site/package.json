{
  "name": "@web/site",
  "version": "0.0.0",
  "description": "Public website for JustPets",
  "license": "FSL-1.1-ALv2",
  "author": "Dogfood Software LLC",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload build",
    "build:docker": "docker build --secret id=FONTAWESOME_PACKAGE_TOKEN,env=FONTAWESOME_PACKAGE_TOKEN --progress=plain -t justpets-site:dockerfile-check -f web/site/Dockerfile .",
    "dev": "rm -rf .next && next dev -p 4040",
    "generate": "payload generate:importmap && payload generate:types",
    "lint": "eslint .",
    "start": "next start -p 4040",
    "format": "oxfmt"
  },
  "dependencies": {
    "@libraries/attributes": "workspace:*",
    "@libraries/i18n": "workspace:*",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation-pino": "^0.71.0",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@payloadcms/db-mongodb": "4.0.0-beta.9",
    "@payloadcms/next": "4.0.0-beta.9",
    "@payloadcms/plugin-mcp": "4.0.0-beta.9",
    "@payloadcms/richtext-lexical": "4.0.0-beta.9",
    "@payloadcms/storage-s3": "4.0.0-beta.9",
    "@payloadcms/transformer-sharp": "4.0.0-beta.9",
    "@payloadcms/ui": "4.0.0-beta.9",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/otel": "^2.3.0",
    "cross-env": "10.1.0",
    "dotenv": "18.0.10",
    "graphql": "^16",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "payload": "4.0.0-beta.9",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@backend/api": "workspace:*",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@web/ui": "workspace:*",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.79.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "pnpm": "^9 || ^10 || ^11 || ^12"
  }
}
